#######################################################
### BLOCKCHAIN CONFIGURATION
#######################################################

# REQUIRED - Blockchain ID
ANTELOPE_CHAIN_ID=aca376f206b8fc25a6ed44dbdc66547c36c6c33e3a119ffbeaef943642f0e906

# REQUIRED - API Endpoint (nodeos)
ANTELOPE_NODEOS_API=https://eos.greymass.com

# REQUIRED - System Token Symbol (e.g. "4,TOKEN")
ANTELOPE_SYSTEM_TOKEN=4,A

# System Contract to use during powerup, buyram, etc (default: core.vaulta)
# ANTELOPE_SYSTEM_CONTRACT=core.vaulta

# System Token Contract (default: core.vaulta)
# ANTELOPE_TOKEN_CONTRACT=core.vaulta

# Noop Contract to use for cosigning (default: greymassnoop)
# ANTELOPE_NOOP_CONTRACT=greymassnoop

# Sample account to use for resource calculations (default: eosio.reserv)
# ANTELOPE_SAMPLE_ACCOUNT=eosio.reserv

#######################################################
### SELF-MANAGEMENT
### Automatically manages the service account's own
### CPU, NET, and RAM to keep the service operational.
#######################################################

# Enable self-management (default: true)
# ENABLE_SELF_MANAGEMENT=true

# REQUIRED - Account name used by the service
# MANAGER_ACCOUNT_NAME=

# Private key to the account/permission (will automatically generate if not defined)
# MANAGER_ACCOUNT_PRIVATEKEY=

# Permission on the account to use (default: "manager")
# MANAGER_ACCOUNT_PERMISSION=manager

# The minimum available CPU (in milliseconds) before a powerup is triggered (default: 5)
# MANAGER_MIN_MS=5

# The minimum available NET (in kilobytes) before a powerup is triggered (default: 5)
# MANAGER_MIN_KB=5

# The amount of CPU (in milliseconds) to powerup when needed (default: 10)
# MANAGER_INC_MS=10

# The amount of NET (in kilobytes) to powerup when needed (default: 10)
# MANAGER_INC_KB=10

# Maximum payment per self-management powerup (default: 0.1000)
# MANAGER_MAX_FEE=0.1000

# Allow automatic RAM purchases to keep the account operational (default: true)
# MANAGER_BUYRAM_ENABLED=true

# The minimum amount of available RAM (in KB) the account should have (default: 1)
# MANAGER_RAM_MINIMUM_KB=1

# The action used on the system contract to buy RAM (default: buyrambytes)
# MANAGER_BUYRAM_ACTION=buyrambytes

# The interval at which self-management runs (cron style, default: every 30 seconds)
# MANAGER_SELF_CRONJOB='0/30 * * * * *'

#######################################################
### AUTOMATED RESOURCE MANAGEMENT
### Manages CPU and NET for a list of other
### accounts on the network.
#######################################################

# Enable the automated resource management system (default: false)
ENABLE_RESOURCE_MANAGER=false

# The interval at which the manager will evaluate managed accounts (cron style)
# MANAGER_CRONJOB='0/10 * * * * *'


#######################################################
### RESOURCE PROVIDER CONFIGURATION
### Cosigns transactions for requesting accounts,
### providing CPU and NET via PowerUp.
###
### Provider policy settings (limits, fees, thresholds,
### usage window) are stored in the database and managed
### with: rpcli config list|get|set|unset
#######################################################

### ---------------------------------------------------
### PROVIDER ACCOUNT

# Enable the resource provider API (default: false)
# ENABLE_RESOURCE_PROVIDER=false

# REQUIRED (when enabled) - Account name of the cosigning account
# PROVIDER_ACCOUNT_NAME=

# Permission on the account to use (default: "provider")
# PROVIDER_ACCOUNT_PERMISSION=provider

# Private key to the account/permission (will automatically generate if not defined)
# PROVIDER_ACCOUNT_PRIVATEKEY=

# Cron schedule for cleaning up expired usage records (default: hourly)
# PROVIDER_USAGE_CLEANUP_CRON='0 * * * *'

### ---------------------------------------------------
### FREE POWERUPS

# Enable direct free powerups (default: false)
# ENABLE_FREE_POWERUP=false

### ---------------------------------------------------
### FREE COSIGNING

# Enable free transaction cosigning (default: false)
# ENABLE_FREE_TRANSACTIONS=false

### ---------------------------------------------------
### PAID COSIGNING

# Enable fee-based transaction cosigning (default: true)
# ENABLE_PAID_TRANSACTIONS=true

### ---------------------------------------------------
### LIGHT ACCOUNT COSIGNING

# Enable the light account cosigning endpoint (default: false)
# ENABLE_LIGHTACCOUNT_PROVIDER=false

# REQUIRED (when enabled) - Light account contract name
# LIGHTACCOUNT_CONTRACT=lightacct

# REQUIRED (when enabled) - Keyhost account name
# LIGHTACCOUNT_KEYHOST=

# Fee multiplier over base PowerUp cost (default: 1.0, e.g. 1.5 for 50% margin)
# LIGHTACCOUNT_FEE_MARGIN=1.0

# REQUIRED (when enabled) - Public key of the light account that receives fees
# LIGHTACCOUNT_FEE_RECIPIENT_KEY=

#######################################################
### GENERAL CONFIGURATION
#######################################################

# ENVIRONMENT=production
# SERVICE_HTTP_PORT=3000
# SERVICE_LOG_LEVEL=info
# SERVICE_INFO_LOG=./info.log
# SERVICE_ERROR_LOG=./error.log

# DATABASE_FILE="resource-provider.db"
